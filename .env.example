# Copy file này thành .env rồi sửa cho đúng máy của bạn:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# KHÔNG commit file .env lên git (đã có trong .gitignore).

APP_NAME=KS25 Base API

# ---- MySQL ----
# Điền giống thông tin bạn dùng để kết nối trong MySQL Workbench
# (Workbench: chuột phải vào connection -> Edit Connection để xem Hostname/Port/Username).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Mật khẩu root bạn đặt lúc cài MySQL (XAMPP mặc định để trống)
DB_PASSWORD=
DB_NAME=app_db

# ---- CORS ----
# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy.
# "*" = cho phép tất cả (tiện khi học/dev). Khi deploy thật hãy ghi rõ domain FE.
# Ví dụ: CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*

# ---- JWT ----
# Chuỗi bí mật để ký JWT. PHẢI đổi thành chuỗi ngẫu nhiên >= 32 ký tự trước khi deploy.
# Tạo nhanh: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_USE_RANDOM_32_CHARS_AT_LEAST
# Thời gian hết hạn token (phút). Mặc định 1440 = 1 ngày.
JWT_EXPIRE_MINUTES=1440
